{
  "name": "runen-scanner",
  "version": "0.1.0",
  "description": "Uebersetzt fotografierte Runenbriefe der Phoenix-Sprachen zurueck in Klartext",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node test/run.js",
    "build": "node build.mjs",
    "ml:train:taluz": ".venv/Scripts/python ml/train_crnn.py --font Phoenix-Taluz",
    "ml:bench:taluz": "node scripts/bench_crnn.mjs img/real/Taluz-15pt-B2.jpg models/taluz-crnn.onnx"
  },
  "devDependencies": {
    "an-array-of-german-words": "^1.2.0",
    "dictionary-de": "^3.0.0",
    "esbuild": "^0.28.2",
    "exifr": "^7.1.3",
    "jpeg-js": "^0.4.4",
    "nspell": "^2.1.5",
    "onnxruntime-node": "^1.27.0",
    "playwright": "^1.62.1"
  }
}
